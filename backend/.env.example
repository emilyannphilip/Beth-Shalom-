HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://beth_shalom:REPLACE_ME@127.0.0.1:5433/beth_shalom_db

# Use separate randomly generated secrets of at least 48 characters.
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_ACCESS_SECONDS=600
AUTH_REFRESH_SECONDS=604800

# Canonical frontend URL. Production requires HTTPS.
PORTAL_ORIGIN=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Local synthetic seed only.
DEV_SEED_ENABLED=false
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_STAFF_USERNAME=
DEV_STAFF_EMAIL=
DEV_STAFF_PASSWORD=
DEV_SEED_SAMPLE_DATA=false
