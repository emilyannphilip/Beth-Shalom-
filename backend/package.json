{
  "name": "@beth-shalom/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:migrate": "node-pg-migrate --migrations-dir ../database/migrations --migration-file-language sql --envPath .env",
    "db:seed": "node --require ts-node/register src/database/seed.ts",
    "db:inventory": "node --require ts-node/register src/database/configure-inventory.ts",
    "test:unit": "node --test test/phase5.unit.cjs test/phase7.unit.cjs",
    "test:integration": "node --test --test-concurrency=1 test/phase5.integration.cjs test/phase7.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "11.4.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.0.0",
    "eslint": "^10.0.0",
    "node-pg-migrate": "7.6.1",
    "smtp-server": "^3.21.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
